# ==============================================================================
# QUIZZBOARD NEW - ENVIRONNEMENT DÉVELOPPEMENT (dev.quizzboard.com)
# ==============================================================================

# PORTS INTERNES CONTENEURS (Liés à 127.0.0.1 sur le serveur pour le Nginx hôte)
CLIENT_PORT=4201
SERVER_PORT=8081
API_PREFIX=/api/v1

# BASE DE DONNÉES POSTGRESQL DEV (Port 5433 isolé)
DB_HOST=postgres-dev
DB_PORT=5433
DB_NAME=quizzboard_dev_db
DB_USER=postgres
DB_PASSWORD=postgres_dev_secure_pwd

# REDIS DEV (Port 6380 isolé)
REDIS_HOST=redis-dev
REDIS_PORT=6380
REDIS_PASSWORD=
LIVE_SESSION_TTL_HOURS=6

# SÉCURITÉ JWT (Clé secrète 256 bits)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS AUTORISÉS DEV
CORS_ORIGINS=https://dev.quizzboard.com,http://dev.quizzboard.com,http://localhost:4201,http://127.0.0.1:4201

# SERVICE EMAIL TRANSACTIONNEL SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=quizzboard@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_smtp_16_lettres
MAIL_FROM=QuizzBoard Dev <quizzboard@gmail.com>
RESET_PASSWORD_URL=https://dev.quizzboard.com/reinitialisation-mot-de-passe?token=
INVITATION_BASE_URL=https://dev.quizzboard.com/invitation/

# GOOGLE AUTHENTICATION (OAuth 2.0)
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com

# PASSERELLES DE PAIEMENT (Mode Test & Simulation)
ENABLE_PAYMENT_SIMULATION=true
PAYDUNYA_MASTER_KEY=votre_master_key_paydunya
PAYDUNYA_PRIVATE_KEY=votre_private_key_paydunya
PAYDUNYA_TOKEN=votre_token_paydunya
PAYDUNYA_MODE=test
PAYDUNYA_RETURN_URL=https://dev.quizzboard.com/app/subscription/callback
PAYDUNYA_CANCEL_URL=https://dev.quizzboard.com/app/subscription
PAYDUNYA_CALLBACK_URL=https://dev.quizzboard.com/api/v1/payments/paydunya/ipn

# MOTEURS D'INTELLIGENCE ARTIFICIELLE
GEMINI_API_KEY=votre_cle_gemini_ici
GROQ_API_KEY=

# STOCKAGE MÉDIAS (Local ou Cloudinary)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
STORAGE_BASE_URL=https://dev.quizzboard.com/api/v1/files
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
