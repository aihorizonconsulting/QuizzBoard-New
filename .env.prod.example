# ==============================================================================
# QUIZZBOARD NEW - ENVIRONNEMENT PRODUCTION (quizzboard.com)
# ==============================================================================

# PORTS INTERNES CONTENEURS (Liés à 127.0.0.1 sur le serveur pour le Nginx hôte)
CLIENT_PORT=4200
SERVER_PORT=8080
API_PREFIX=/api/v1

# BASE DE DONNÉES POSTGRESQL PROD
DB_HOST=postgres-prod
DB_PORT=5432
DB_NAME=quizzboard_prod_db
DB_USER=postgres
DB_PASSWORD=generer_un_mot_de_passe_robuste_pour_prod

# REDIS PROD
REDIS_HOST=redis-prod
REDIS_PORT=6379
REDIS_PASSWORD=
LIVE_SESSION_TTL_HOURS=6

# SÉCURITÉ JWT (Clé secrète 256 bits unique pour la prod)
JWT_SECRET=generer_une_cle_hex_aleatoire_256_bits_different_de_dev
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS AUTORISÉS PRODUCTION
CORS_ORIGINS=https://quizzboard.com,https://www.quizzboard.com

# SERVICE EMAIL TRANSACTIONNEL SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=quizzboard@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_smtp_16_lettres
MAIL_FROM=QuizzBoard <quizzboard@gmail.com>
RESET_PASSWORD_URL=https://quizzboard.com/reinitialisation-mot-de-passe?token=
INVITATION_BASE_URL=https://quizzboard.com/invitation/

# GOOGLE AUTHENTICATION (OAuth 2.0)
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com

# PASSERELLES DE PAIEMENT (Mode Live Marchand)
ENABLE_PAYMENT_SIMULATION=false
PAYDUNYA_MASTER_KEY=votre_master_key_paydunya
PAYDUNYA_PRIVATE_KEY=votre_private_key_paydunya
PAYDUNYA_TOKEN=votre_token_paydunya
PAYDUNYA_MODE=live
PAYDUNYA_RETURN_URL=https://quizzboard.com/app/subscription/callback
PAYDUNYA_CANCEL_URL=https://quizzboard.com/app/subscription
PAYDUNYA_CALLBACK_URL=https://quizzboard.com/api/v1/payments/paydunya/ipn

# MOTEURS D'INTELLIGENCE ARTIFICIELLE
GEMINI_API_KEY=votre_cle_gemini_prod
GROQ_API_KEY=

# STOCKAGE MÉDIAS (Cloudinary recommandé en production)
STORAGE_PROVIDER=cloudinary
LOCAL_UPLOAD_DIR=uploads
STORAGE_BASE_URL=https://quizzboard.com/api/v1/files
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
